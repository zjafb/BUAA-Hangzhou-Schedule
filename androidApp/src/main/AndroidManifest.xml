<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12+ 精确闹钟：未声明时 setExactAndAllowWhileIdle 会抛 SecurityException，
         只能退化到非精确闹钟，Doze/待机下提醒可能被推迟几十分钟甚至收不到。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 开机后重新排课提醒与计划提醒：AlarmManager 的闹钟不会跨重启存活。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <receiver android:name="cn.edu.buaa.hzcampus.widget.ScheduleWidgetProvider"
            android:exported="false" android:label="北航杭州 周课表">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/schedule_widget_info" />
        </receiver>
        <receiver android:name="cn.edu.buaa.hzcampus.widget.TodayScheduleWidgetProvider" android:exported="false" android:label="北航杭州 今日课程">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/schedule_today_widget_info" />
        </receiver>
        <receiver android:name="cn.edu.buaa.hzcampus.widget.UpcomingScheduleWidgetProvider" android:exported="false" android:label="北航杭州 近日课程">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/schedule_upcoming_widget_info" />
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <receiver android:name="cn.edu.buaa.hzcampus.ui.common.util.ClassReminderReceiver" android:exported="false" />
        <receiver android:name="cn.edu.buaa.hzcampus.ui.common.util.PlanReminderReceiver" android:exported="false" />
        <receiver android:name="cn.edu.buaa.hzcampus.ui.common.util.BootReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <activity android:name="cn.edu.buaa.hzcampus.widget.ScheduleWidgetActivity" android:exported="false" />
        <activity
            android:exported="true"
            android:name="cn.edu.buaa.hzcampus.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
